doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='OXBIY creates secure, scalable digital solutions that help businesses and individuals turn ideas into trusted products.')
        meta(name='author', content='OXBIY')

        title OXBIY — Secure Digital Solutions

        // Canonical URL
        link(rel='canonical', href='https://oxbiy.com/')

        // Open Graph
        meta(property='og:type', content='website')
        meta(property='og:site_name', content='OXBIY')
        meta(property='og:title', content='OXBIY — Secure Digital Solutions')
        meta(property='og:description', content='OXBIY creates secure, scalable digital solutions that help businesses and individuals turn ideas into trusted products.')
        meta(property='og:url', content='https://oxbiy.com/')
        meta(property='og:image', content='https://oxbiy.com/assets/img/bg-masthead.jpg')
        meta(property='og:image:width', content='1600')
        meta(property='og:image:height', content='900')
        meta(property='og:image:alt', content='OXBIY — Secure Digital Solutions')

        // Twitter Card
        meta(name='twitter:card', content='summary_large_image')
        meta(name='twitter:title', content='OXBIY — Secure Digital Solutions')
        meta(name='twitter:description', content='OXBIY creates secure, scalable digital solutions that help businesses and individuals turn ideas into trusted products.')
        meta(name='twitter:image', content='https://oxbiy.com/assets/img/bg-masthead.jpg')

        // Favicon
        link(rel='icon', type='image/png', href='assets/img/oxbiy_logo_transparent.png')
        link(rel='apple-touch-icon', href='assets/img/oxbiy_logo_transparent.png')

        // Preload hero poster for faster LCP
        link(rel='preload', as='image', href='assets/img/bg-masthead.jpg')

        // Bootstrap Icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css', rel='stylesheet')

        // Google fonts
        link(rel='preconnect', href='https://fonts.googleapis.com')
        link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin='')
        link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap', rel='stylesheet')

        // Preconnect for external images
        link(rel='preconnect', href='https://images.unsplash.com')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

        // Analytics (Plausible — privacy-first, no cookie banner needed)
        script(defer, data-domain='oxbiy.com', src='https://plausible.io/js/plausible.js')

        // JSON-LD Organization schema
        script(type='application/ld+json').
            {
                "@context": "https://schema.org",
                "@type": "Organization",
                "name": "OXBIY",
                "url": "https://oxbiy.com",
                "logo": "https://oxbiy.com/assets/img/logo.png",
                "description": "OXBIY creates secure, scalable digital solutions that help businesses and individuals turn ideas into trusted products.",
                "telephone": "+237676887147",
                "email": "help-support@oxbiy.com",
                "sameAs": [
                    "https://www.linkedin.com/in/oxbiy-company-74b356410",
                    "https://www.facebook.com/share/18j4TQiY39/",
                    "https://www.instagram.com/oxbiy"
                ]
            }

    body#page-top

        a.skip-to-main(href='#about') Skip to main content

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-light.fixed-top.py-3
            .container.px-4.px-lg-5
                a.navbar-brand.d-flex.align-items-center.gap-2(href='#page-top' aria-label='OXBIY home')
                    img.logo(src='/assets/img/logo.png', alt='OXBIY')
                    span.brand-name OXBIY
                button.navbar-toggler.navbar-toggler-right(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.my-2.my-lg-0.align-items-lg-center
                        li.nav-item
                            a.nav-link(href='#about') About
                        li.nav-item
                            a.nav-link(href='about-us.html') Team
                        li.nav-item
                            a.nav-link(href='#services') Services
                        li.nav-item
                            a.nav-link(href='#portfolio') Portfolio
                        li.nav-item
                            a.nav-link(href='#contact') Contact
                        li.nav-item.ms-lg-2.mt-2.mt-lg-0
                            a.btn.btn-primary.btn-sm.px-3(href='#contact') Get Started

        // Masthead
        header.masthead
            video.masthead-video(autoplay muted loop playsinline preload='none' poster='assets/img/bg-masthead.jpg')
                source(src='/assets/video/typing-bg.mp4', type='video/mp4')

            .container.px-4.px-lg-5.h-100
                .row.gx-4.gx-lg-5.h-100.align-items-center.justify-content-center.text-center
                    .col-lg-9.col-xl-8
                        .hero-badge Software Engineering Studio
                        h1.text-white OXBIY
                        span.hero-tagline Building Empires In The Digital Age
                        p.text-white-75.mb-0
                            | We create secure, scalable digital solutions that help businesses and individuals turn ideas into trusted products.
                        .hero-ctas.d-flex.gap-3.justify-content-center.flex-wrap.mt-5
                            a.btn.btn-primary.btn-xl(href='#about') Start a Project
                            a.btn.btn-outline-light.btn-xl(href='#portfolio') View Our Work

            .hero-scroll
                a.hero-scroll-link(href='#about' aria-label='Scroll to content')
                    i.bi-chevron-compact-down

        // About
        section#about.page-section.bg-light
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.align-items-center
                    .col-lg-6
                        .section-badge About OXBIY
                        h2.mt-0 Who We Are
                        hr.divider.ms-0
                        p.text-muted.mb-4
                            | OXBIY is a technology company specializing in building secure, scalable web and mobile products. We help startups and enterprises transform ideas into reliable digital platforms with strong design, robust engineering, and security-first practices.
                        ul.list-unstyled.about-check-list.mb-4
                            li
                                .check-icon: i.bi-shield-check
                                span Security-first development approach
                            li
                                .check-icon: i.bi-cloud
                                span Scalable cloud architecture
                            li
                                .check-icon: i.bi-people-fill
                                span Human-centered UI/UX design
                        a.btn.btn-primary.btn-xl(href='#services') Our Services
                    .col-lg-6
                        img.img-fluid.rounded-3.shadow-lg(src='https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fm=webp&fit=crop&w=800&q=80', alt='OXBIY Team Collaboration', loading='lazy', width='800', height='600')

        // Stats
        section#stats.page-section.bg-primary.text-white
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.text-center
                    .col-6.col-md-3.mb-4.mb-md-0.fade-up
                        .stat-item
                            .stat-number 7
                            .stat-label Specialists
                    .col-6.col-md-3.mb-4.mb-md-0.fade-up
                        .stat-item
                            .stat-number 3+
                            .stat-label Products Built
                    .col-6.col-md-3.fade-up
                        .stat-item
                            .stat-number 24h
                            .stat-label Response Time
                    .col-6.col-md-3.fade-up
                        .stat-item
                            .stat-number 100%
                            .stat-label Security-First

        // Team
        section#team.page-section.bg-white
            .container.px-4.px-lg-5
                .text-center.mb-5
                    h2.fade-up Team Presentation
                    hr.divider.fade-up
                    p.lead.text-muted.fade-up The core team engineering secure digital futures.
                .row.gx-4.gx-lg-5.justify-content-center
                    // Team Member: Derek Noumbissi
                    .col-lg-3.col-md-6.mb-5.fade-up
                        .team-bubble.text-center
                            .member-icon-wrap
                                img(src='assets/img/team/derek.jpg', alt='Derek Noumbissi', loading='lazy')
                            h4 Derek Noumbissi
                            p.text-primary Chief Financial Officer

                    // Team Member: Fayssal Ndassa
                    .col-lg-3.col-md-6.mb-5.fade-up
                        .team-bubble.text-center
                            .member-icon-wrap
                                img(src='assets/img/team/fayssal.jpg', alt='Fayssal Ndassa', loading='lazy')
                            h4 Fayssal Ndassa
                            p.text-primary Head of Marketing & Communications

                    // Team Member: Sacha Mawabo
                    .col-lg-3.col-md-6.mb-5.fade-up
                        .team-bubble.text-center
                            .member-icon-wrap
                                img(src='assets/img/team/sacha.jpg', alt='Sacha Mawabo', loading='lazy')
                            h4 Sacha Mawabo
                            p.text-primary Head of Customer Experience & Operations

                    // Team Member: Chofor Clarkson
                    .col-lg-3.col-md-6.mb-5.fade-up
                        .team-bubble.text-center
                            .member-icon-wrap
                                img(src='assets/img/team/chofor.jpg', alt='Chofor Clarkson', loading='lazy')
                            h4 Chofor Clarkson
                            p.text-primary Chief Technology Officer

                    // Team Member: Brondon Nouyeutchui
                    .col-lg-3.col-md-6.mb-5.fade-up
                        .team-bubble.text-center
                            .member-icon-wrap
                                img(src='assets/img/team/brondon.jpg', alt='Brondon Nouyeutchui', loading='lazy')
                            h4 Brondon Nouyeutchui
                            p.text-primary IS Security & Audit Specialist

                    // Team Member: Destin Nedjou
                    .col-lg-3.col-md-6.mb-5.fade-up
                        .team-bubble.text-center
                            .member-icon-wrap
                                img(src='assets/img/team/destin.jpg', alt='Destin Nedjou', loading='lazy')
                            h4 Destin Nedjou
                            p.text-primary Chief DevSecOps Engineer

                    // Team Member: Arrey Osambenghe
                    .col-lg-3.col-md-6.mb-5.fade-up
                        .team-bubble.text-center
                            .member-icon-wrap
                                img(src='assets/img/team/arrey.jpg', alt='Arrey Osambenghe', loading='lazy')
                            h4 Arrey Osambenghe
                            p.text-primary Software Engineer & Developer

                .text-center.mt-4.fade-up
                    a.btn.btn-outline-primary(href='about-us.html') View Full Profiles & Bios

        // Services
        section#services.page-section.bg-light
            .container.px-4.px-lg-5
                .text-center.mb-5
                    .section-badge.fade-up What We Do
                    h2.fade-up Our Services
                    hr.divider.fade-up
                    p.lead.mx-auto.fade-up OXBIY delivers end-to-end product engineering and secure platform services.
                .row.gx-4.gx-lg-5
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .service-card.h-100
                            .service-icon-wrap: i.bi-window-stack
                            h4 Web Application Development
                            p Enterprise-grade web platforms focused on performance and reliability.
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .service-card.h-100
                            .service-icon-wrap: i.bi-phone-fill
                            h4 Mobile Application Development
                            p Native and cross-platform mobile apps built for engagement and retention.
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .service-card.h-100
                            .service-icon-wrap: i.bi-bezier2
                            h4 UI/UX Design
                            p Product design that converts users through clarity and polished interfaces.
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .service-card.h-100
                            .service-icon-wrap: i.bi-gear-fill
                            h4 Business Process Automation
                            p Automation and integrations that reduce manual work and speed delivery.
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .service-card.h-100
                            .service-icon-wrap: i.bi-plug-fill
                            h4 API Development & Integration
                            p Secure APIs and integrations to connect your ecosystem.
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .service-card.h-100
                            .service-icon-wrap: i.bi-shield-check
                            h4 Cybersecurity & Compliance
                            p Security reviews, threat modelling, and compliance guidance.

        // Featured Projects (Z-Pattern)
        section#portfolio.page-section.bg-transparent-overlay.text-white
            .container.px-4.px-lg-5
                .text-center.mb-5
                    h2.text-white Featured Projects
                    hr.divider.divider-light
                    p.lead.text-white-75 Selected work that demonstrates our secure, scalable approach.

                // Project 1
                .row.gx-4.gx-lg-5.mb-5.align-items-center.fade-up
                    .col-lg-7
                        img.img-fluid.rounded-3.shadow(src='https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fm=webp&fit=crop&w=1200&q=80', alt='Job Finder — Recruitment Platform', loading='lazy', width='1200', height='800')
                    .col-lg-5
                        .p-4.bg-white.rounded-3.shadow.text-dark
                            .badge.bg-primary.mb-2 Recruitment
                            h3.mb-3 Job Finder
                            p.text-muted
                                | A recruitment platform that connects job seekers with employers through an intuitive and secure interface. Built with scalability in mind to handle high volumes of applications and real-time notifications.
                            a.btn.btn-outline-primary(href='project-jobbe.html') View Details

                // Project 2
                .row.gx-4.gx-lg-5.align-items-center.fade-up
                    .col-lg-7.order-lg-2
                        img.img-fluid.rounded-3.shadow(src='https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fm=webp&fit=crop&w=1200&q=80', alt='Chez Moi — Real Estate Platform', loading='lazy', width='1200', height='800')
                    .col-lg-5.order-lg-1
                        .p-4.bg-white.rounded-3.shadow.text-dark
                            .badge.bg-primary.mb-2 Real Estate
                            h3.mb-3 Chez Moi
                            p.text-muted
                                | A real estate platform that helps users discover and rent houses or apartments easily. Features advanced filtering, secure document handling, and integrated map services.
                            a.btn.btn-outline-primary(href='project-chez-moi.html') View Details

        // Call to action
        section.page-section.bg-primary.text-white.text-center
            .container.px-4.px-lg-5
                h2.mb-4 Ready to build the future?
                p.lead.mb-5 Tell us about your idea and we'll help you build it securely and at scale.
                a.btn.btn-light.btn-xl(href='#contact') Get Started

        // Testimonials
        section#testimonials.page-section.bg-light
            .container.px-4.px-lg-5
                .text-center.mb-5
                    h2.fade-up What Clients Say
                    hr.divider.fade-up
                    p.lead.text-muted.fade-up Real feedback from people we've built for.
                .row.gx-4.gx-lg-5.justify-content-center
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .testimonial-card
                            .testimonial-stars
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                            blockquote.testimonial-text
                                | "OXBIY built our entire platform from scratch. Security was embedded from day one — we passed our compliance audit without a single finding."
                            .testimonial-author
                                .testimonial-avatar AM
                                div
                                    .testimonial-name Alain M.
                                    .testimonial-role CEO, FinTech Startup
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .testimonial-card
                            .testimonial-stars
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                            blockquote.testimonial-text
                                | "The team understood our vision immediately. The interface they designed converted significantly better than our old solution. Highly recommended."
                            .testimonial-author
                                .testimonial-avatar SK
                                div
                                    .testimonial-name Sophie K.
                                    .testimonial-role Founder, E-commerce Brand
                    .col-lg-4.col-md-6.mb-4.fade-up
                        .testimonial-card
                            .testimonial-stars
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                                i.bi-star-fill
                            blockquote.testimonial-text
                                | "Working with OXBIY felt like having a senior tech team in-house. Fast, reliable, and always security-conscious. They exceeded every deadline."
                            .testimonial-author
                                .testimonial-avatar KT
                                div
                                    .testimonial-name Kevin T.
                                    .testimonial-role CTO, SaaS Company

        // Contact
        section#contact.page-section
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center
                    .col-lg-8.col-xl-6.text-center
                        h2.mt-0 Let's Get In Touch
                        hr.divider
                        p.text-muted.mb-5
                            | Have a project in mind? Fill the form below and we'll reach out within 24 hours.
                .row.gx-4.gx-lg-5.justify-content-center.mb-5
                    .col-lg-6
                        form#contactForm(action='https://formspree.io/f/xpqnygdw', method='POST', novalidate)
                            .form-floating.mb-3
                                input#name.form-control(type='text', name='name', placeholder='Full name', required)
                                label(for='name') Full name
                                .invalid-feedback Please enter your full name.
                            .form-floating.mb-3
                                input#email.form-control(type='email', name='email', placeholder='name@example.com', required)
                                label(for='email') Email address
                                .invalid-feedback Please enter a valid email address.
                            .form-floating.mb-3
                                input#phone.form-control(type='tel', name='phone', placeholder='+237 6XX XXX XXX')
                                label(for='phone') Phone number (optional)
                            .form-floating.mb-3
                                textarea#message.form-control(name='message', placeholder='Your message', style='height: 10rem;', required)
                                label(for='message') Message
                                .invalid-feedback Please enter a message.
                            #formSuccess.d-none.alert.alert-success.mt-3(role='status')
                                i.bi-check-circle-fill.me-2
                                | Your message has been sent! We'll be in touch soon.
                            #formError.d-none.alert.alert-danger.mt-3(role='alert')
                                i.bi-exclamation-triangle-fill.me-2
                                | Something went wrong. Please email us directly at
                                |
                                a.alert-link(href='mailto:help-support@oxbiy.com') help-support@oxbiy.com
                            .d-grid.mt-3
                                button#submitButton.btn.btn-primary.btn-xl(type='submit') Send Message

                .row.gx-4.gx-lg-5.justify-content-center
                    .col-lg-4.text-center.mb-5.mb-lg-0
                        i.bi-phone.fs-2.mb-3.text-muted
                        div +237 676887147

        // Footer
        footer.footer-main
            .container.px-4.px-lg-5
                .row.gx-5.gy-5.mb-2
                    .col-lg-4.col-md-12
                        img.footer-logo(src='/assets/img/logo.png', alt='OXBIY')
                        .footer-brand-name OXBIY
                        p.footer-desc OXBIY builds secure, scalable digital solutions for businesses and individuals worldwide.
                        .d-flex.gap-2.mt-4
                            a.footer-social-link(href='https://www.linkedin.com/in/oxbiy-company-74b356410', target='_blank', rel='noreferrer', aria-label='LinkedIn')
                                i.bi-linkedin
                            a.footer-social-link(href='https://www.facebook.com/share/18j4TQiY39/', target='_blank', rel='noreferrer', aria-label='Facebook')
                                i.bi-facebook
                            a.footer-social-link(href='https://www.instagram.com/oxbiy', target='_blank', rel='noreferrer', aria-label='Instagram')
                                i.bi-instagram
                    .col-lg-2.col-md-4.col-6
                        h6.footer-heading Navigation
                        ul.footer-links
                            li: a(href='#about') About
                            li: a(href='about-us.html') Team
                            li: a(href='#services') Services
                            li: a(href='#portfolio') Portfolio
                            li: a(href='#contact') Contact
                    .col-lg-2.col-md-4.col-6
                        h6.footer-heading Projects
                        ul.footer-links
                            li: a(href='project-jobbe.html') Job Finder
                            li: a(href='project-chez-moi.html') Chez Moi
                    .col-lg-4.col-md-4
                        h6.footer-heading Contact
                        .footer-contact-item
                            i.bi-envelope
                            a(href='mailto:help-support@oxbiy.com') help-support@oxbiy.com
                        .footer-contact-item
                            i.bi-telephone
                            span +237 676 887 147
                        .footer-contact-item
                            i.bi-globe
                            a(href='https://oxbiy.com') oxbiy.com
                .footer-bottom
                    .container.px-0
                        .d-flex.flex-column.flex-md-row.justify-content-between.align-items-center.gap-2
                            p.small &copy; 2026 OXBIY. All rights reserved.
                            p.small Building Empires In The Digital Age

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js')
