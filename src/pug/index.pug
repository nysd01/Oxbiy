doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Creative - Start Bootstrap Theme

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Bootstrap Icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet')

        // Google fonts
        link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Roboto:wght@300;400;500;700&display=swap', rel='stylesheet')

        // SimpleLightbox plugin CSS
        link(href='https://cdnjs.cloudflare.com/ajax/libs/SimpleLightbox/2.1.0/simpleLightbox.min.css', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-light.fixed-top.py-3
            .container.px-4.px-lg-5
                a.navbar-brand.d-flex.align-items-center.gap-2(href='#page-top' aria-label='OXBIY home')
                    img.logo(src='/assets/img/logo.png', alt='OXBIY')
                    span.brand-name OXBIY
                button.navbar-toggler.navbar-toggler-right(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.my-2.my-lg-0
                        li.nav-item
                            a.nav-link(href='#about') About
                        li.nav-item
                            a.nav-link(href='about-us.html') Team
                        li.nav-item
                            a.nav-link(href='#services') Services
                        li.nav-item
                            a.nav-link(href='#portfolio') Portfolio
                        li.nav-item
                            a.nav-link(href='#contact') Contact

        // Masthead
        header.masthead
            // Background video
            video.masthead-video(autoplay muted loop playsinline poster='assets/img/bg-masthead.jpg')
                source(src='/assets/video/typing-bg.mp4', type='video/mp4')

            .container.px-4.px-lg-5.h-100
                .row.gx-4.gx-lg-5.h-100.align-items-center.justify-content-center.text-center
                    .col-lg-8.align-self-end
                        h1.text-white.font-weight-bold OXBIY
                        hr.divider
                    .col-lg-8.align-self-baseline
                        p.text-white-75.mb-5
                            | OXBIY creates secure, scalable digital solutions that help businesses and individuals turn ideas into trusted products.
                        a.btn.btn-primary.btn-xl(href='#about') Find Out More

        // About
        section#about.page-section.bg-light
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.align-items-center
                    .col-lg-6
                        h2.mt-0 Who We Are
                        hr.divider.ms-0
                        p.text-muted.mb-4
                            | OXBIY is a technology company specializing in building secure, scalable web and mobile products. We help startups and enterprises transform ideas into reliable digital platforms with strong design, robust engineering, and security-first practices.
                        ul.list-unstyled.mb-4
                            li.mb-2
                                i.bi-check-circle-fill.text-primary.me-2
                                | Security-first development approach
                            li.mb-2
                                i.bi-check-circle-fill.text-primary.me-2
                                | Scalable cloud architecture
                            li.mb-2
                                i.bi-check-circle-fill.text-primary.me-2
                                | Human-centered UI/UX design
                        a.btn.btn-primary.btn-xl(href='#services') Our Services
                    .col-lg-6
                        img.img-fluid.rounded-3.shadow-lg(src='https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=800&q=80', alt='OXBIY Team Collaboration')

        // Team
        section#team.page-section.bg-white
            .container.px-4.px-lg-5
                .text-center.mb-5
                    h2 Meet Our Team
                    hr.divider
                    p.lead.text-muted The experts behind our secure solutions.
                .row.gx-4.gx-lg-5.justify-content-center
                    // Team Member 1
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-shield-lock
                            h4.h5.mb-1 Team Member 1
                            p.text-primary.small.fw-bold.mb-3 Lead Architect
                            p.text-muted.small.mb-0
                                | Specialized in building high-security distributed systems.
                    // Team Member 2
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-code-slash
                            h4.h5.mb-1 Team Member 2
                            p.text-primary.small.fw-bold.mb-3 Senior Engineer
                            p.text-muted.small.mb-0
                                | Focused on scalable backend infrastructure and automation.
                    // Team Member 3
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-palette
                            h4.h5.mb-1 Team Member 3
                            p.text-primary.small.fw-bold.mb-3 UI/UX Designer
                            p.text-muted.small.mb-0
                                | Crafting intuitive and secure user experiences.
                    // Team Member 4
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-graph-up-arrow
                            h4.h5.mb-1 Team Member 4
                            p.text-primary.small.fw-bold.mb-3 Growth Lead
                            p.text-muted.small.mb-0
                                | Bridging the gap between technology and business value.
                    // Team Member 5
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-cpu
                            h4.h5.mb-1 Team Member 5
                            p.text-primary.small.fw-bold.mb-3 Tech Strategist
                            p.text-muted.small.mb-0
                                | Driving innovation through cutting-edge technology adoption.
                .text-center.mt-4
                    a.btn.btn-outline-primary(href='about-us.html') Learn More About Us

        // Services
        section#services.page-section.bg-light
            .container.px-4.px-lg-5
                .text-center.mb-5
                    h2 Our Services
                    hr.divider
                    p.lead.mx-auto OXBIY delivers end-to-end product engineering and secure platform services.
                .row.gx-4.gx-lg-5
                    .col-lg-4.col-md-6.mb-4
                        .service-card.h-100.text-center
                            i.bi-window-stack
                            h4 Web Application Development
                            p Enterprise-grade web platforms focused on performance and reliability.
                    .col-lg-4.col-md-6.mb-4
                        .service-card.h-100.text-center
                            i.bi-phone-fill
                            h4 Mobile Application Development
                            p Native and cross-platform mobile apps built for engagement and retention.
                    .col-lg-4.col-md-6.mb-4
                        .service-card.h-100.text-center
                            i.bi-bezier2
                            h4 UI/UX Design
                            p Product design that converts users through clarity and polished interfaces.
                    .col-lg-4.col-md-6.mb-4
                        .service-card.h-100.text-center
                            i.bi-gear-fill
                            h4 Business Process Automation
                            p Automation and integrations that reduce manual work and speed delivery.
                    .col-lg-4.col-md-6.mb-4
                        .service-card.h-100.text-center
                            i.bi-plug-fill
                            h4 API Development & Integration
                            p Secure APIs and integrations to connect your ecosystem.
                    .col-lg-4.col-md-6.mb-4
                        .service-card.h-100.text-center
                            i.bi-shield-check
                            h4 Cybersecurity & Compliance
                            p Security reviews, threat modelling, and compliance guidance.

        // Featured Projects (Z-Pattern)
        section#portfolio.page-section.bg-transparent-overlay.text-white
            .container.px-4.px-lg-5
                .text-center.mb-5
                    h2.text-white Featured Projects
                    hr.divider.divider-light
                    p.lead.text-white-75 Selected work that demonstrates our secure, scalable approach.
                
                // Project 1
                .row.gx-4.gx-lg-5.mb-5.align-items-center
                    .col-lg-7
                        img.img-fluid.rounded-3.shadow(src='assets/img/portfolio/fullsize/1.jpg', alt='Job Finder')
                    .col-lg-5
                        .p-4.bg-white.rounded-3.shadow.text-dark
                            .badge.bg-primary.mb-2 Recruitment
                            h3.mb-3 Job Finder
                            p.text-muted
                                | A recruitment platform that connects job seekers with employers through an intuitive and secure interface. Built with scalability in mind to handle high volumes of applications and real-time notifications.
                            a.btn.btn-outline-primary(href='project-jobbe.html') View Details

                // Project 2
                .row.gx-4.gx-lg-5.align-items-center
                    .col-lg-7.order-lg-2
                        img.img-fluid.rounded-3.shadow(src='assets/img/portfolio/fullsize/2.jpg', alt='Chez Moi')
                    .col-lg-5.order-lg-1
                        .p-4.bg-white.rounded-3.shadow.text-dark
                            .badge.bg-primary.mb-2 Real Estate
                            h3.mb-3 Chez Moi
                            p.text-muted
                                | A real estate platform that helps users discover and rent houses or apartments easily. Features advanced filtering, secure document handling, and integrated map services.
                            a.btn.btn-outline-primary(href='project-chez-moi.html') View Details

        // Call to action
        section.page-section.bg-primary.text-white.text-center
            .container.px-4.px-lg-5
                h2.mb-4 Ready to build the future?
                p.lead.mb-5 Tell us about your idea and we'll help you build it securely and at scale.
                a.btn.btn-light.btn-xl(href='#contact') Get Started

        // Contact
        section#contact.page-section
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center
                    .col-lg-8.col-xl-6.text-center
                        h2.mt-0 Let's Get In Touch
                        hr.divider
                        p.text-muted.mb-5
                            | Have a project in mind? Fill the form and we'll reach out — or email help-support@oxbiy.com directly.
                .row.gx-4.gx-lg-5.justify-content-center.mb-5
                    .col-lg-6
                        form#contactForm(data-sb-form-api-token='API_TOKEN')
                            .form-floating.mb-3
                                input#name.form-control(type='text', placeholder='Full name', data-sb-validations='required')
                                label(for='name') Full name
                            .form-floating.mb-3
                                input#email.form-control(type='email', placeholder='name@example.com', data-sb-validations='required,email')
                                label(for='email') Email address
                            .form-floating.mb-3
                                textarea#message.form-control(placeholder='Your message', style='height: 10rem;', data-sb-validations='required')
                                label(for='message') Message
                            .d-grid
                                button#submitButton.btn.btn-primary.btn-xl(type='submit') Send Message

                .row.gx-4.gx-lg-5.justify-content-center
                    .col-lg-4.text-center.mb-5.mb-lg-0
                        i.bi-phone.fs-2.mb-3.text-muted
                        div +237 676887147

        // Footer
        footer.bg-light.py-5
            .container.px-4.px-lg-5
                .footer-brand.text-center.mb-3
                    img.footer-logo(src='/assets/img/logo.png', alt='OXBIY')
                    .fw-bold.text-dark OXBIY
                    .text-muted OXBIY builds secure, scalable digital solutions for businesses and individuals.
                    .footer-social.d-flex.justify-content-center.gap-3.mt-3
                        a(href='https://www.linkedin.com', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on LinkedIn')
                            i.bi-linkedin
                        a(href='https://www.facebook.com/share/18j4TQiY39/', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Facebook')
                            i.bi-facebook
                        a(href='https://www.instagram.com/oxbiy?utm_source=qr&igsh=MWZudGhpbmVsY201eQ==', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Instagram')
                            i.bi-instagram
                .small.text-center.text-muted
                    | Copyright &copy; 2026 OXBIY. All rights reserved.

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // SimpleLightbox plugin JS
        script(src='https://cdnjs.cloudflare.com/ajax/libs/SimpleLightbox/2.1.0/simpleLightbox.min.js')

        // Core theme JS
        script(src='js/scripts.js')

        // * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
        // * *                               SB Forms JS                               * *
        // * * Activate your form at https://startbootstrap.com/solution/contact-forms * *
        // * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

        script(src='https://cdn.startbootstrap.com/sb-forms-latest.js')
