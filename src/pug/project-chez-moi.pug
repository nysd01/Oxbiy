doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Chez Moi - A secure real estate platform by OXBIY.')
        meta(name='author', content='OXBIY')

        title Chez Moi Case Study - OXBIY

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Bootstrap Icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet')

        // Google fonts
        link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Roboto:wght@300;400;500;700&display=swap', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-light.fixed-top.py-3.navbar-shrink
            .container.px-4.px-lg-5
                a.navbar-brand.d-flex.align-items-center.gap-2(href='index.html')
                    img.logo(src='/assets/img/logo.png', alt='OXBIY')
                    span.brand-name OXBIY
                button.navbar-toggler.navbar-toggler-right(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.my-2.my-lg-0
                        li.nav-item
                            a.nav-link(href='index.html') Home
                        li.nav-item
                            a.nav-link(href='about-us.html') About

        // Header
        header.masthead.small-masthead.bg-primary.text-white
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center.text-center
                    .col-lg-8
                        h1.font-weight-bold Chez Moi
                        hr.divider.divider-light
                        p.text-white-75.mb-0
                            | Streamlining property rentals through transparency and secure automation.

        // Project Content
        section.page-section
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5
                    .col-lg-8
                        h2.mb-4 The Vision
                        p.text-muted.mb-4
                            | Finding a rental property is often a fragmented and stressful process. Chez Moi was designed to unify the rental journey, providing landlords and tenants with a single, secure environment to manage everything from listings to digital contracts.
                        
                        h2.mb-4 Key Features
                        p.text-muted.mb-4
                            | We implemented a robust property verification system to eliminate fraudulent listings and integrated a secure document management portal for lease signing and identity verification.
                        
                        .row.mb-4
                            .col-md-6.mb-3
                                .p-3.bg-light.rounded-3
                                    h5.h6.fw-bold Smart Filtering
                                    p.small.text-muted.mb-0 Find the perfect home with advanced, localized search parameters.
                            .col-md-6.mb-3
                                .p-3.bg-light.rounded-3
                                    h5.h6.fw-bold Secure Payments
                                    p.small.text-muted.mb-0 Integrated payment gateways for rent and deposit collection.

                    .col-lg-4
                        .card.border-0.shadow-sm.rounded-3.p-4.mb-4
                            h5.h6.fw-bold.mb-3 Project Info
                            ul.list-unstyled.small.mb-0
                                li.mb-2.d-flex.justify-content-between
                                    span.text-muted Client:
                                    span.fw-bold Real Estate Group
                                li.mb-2.d-flex.justify-content-between
                                    span.text-muted Category:
                                    span.fw-bold PropTech
                                li.mb-2.d-flex.justify-content-between
                                    span.text-muted Date:
                                    span.fw-bold April 2026
                                li.d-flex.justify-content-between
                                    span.text-muted Tech:
                                    span.fw-bold Vue.js, Firebase

                .row.gx-4.gx-lg-5.mt-5.g-4
                    .col-md-6
                        img.img-fluid.rounded-3.shadow(src='https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=800&q=80', alt='Chez Moi Modern Interior Listing')
                    .col-md-6
                        img.img-fluid.rounded-3.shadow(src='https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80', alt='Chez Moi Data & Search Analytics Dashboard')

        // Footer
        footer.bg-light.py-5
            .container.px-4.px-lg-5.text-center
                img.footer-logo.mb-3(src='/assets/img/logo.png', alt='OXBIY')
                .footer-social.d-flex.justify-content-center.gap-3.mb-4
                    a.text-muted(href='#', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on LinkedIn')
                        i.bi-linkedin
                    a.text-muted(href='https://www.facebook.com/share/18j4TQiY39/', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Facebook')
                        i.bi-facebook
                    a.text-muted(href='https://www.instagram.com/oxbiy?utm_source=qr&igsh=MWZudGhpbmVsY201eQ==', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Instagram')
                        i.bi-instagram
                a.btn.btn-primary.btn-xl.mb-4(href='index.html#portfolio') Back to Projects
                div OXBIY © 2026

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/scripts.js')
