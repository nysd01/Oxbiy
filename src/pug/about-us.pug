doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Meet the talented team behind OXBIY.')
        meta(name='author', content='OXBIY')

        title About Our Team - OXBIY

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Bootstrap Icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css', rel='stylesheet')

        // Google fonts
        link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Roboto:wght@300;400;500;700&display=swap', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-light.fixed-top.py-3.navbar-shrink
            .container.px-4.px-lg-5
                a.navbar-brand.d-flex.align-items-center.gap-2(href='index.html')
                    img.logo(src='/assets/img/logo.png', alt='OXBIY')
                    span.brand-name OXBIY
                button.navbar-toggler.navbar-toggler-right(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.my-2.my-lg-0
                        li.nav-item
                            a.nav-link(href='index.html') Home
                        li.nav-item
                            a.nav-link(href='index.html#services') Services
                        li.nav-item
                            a.nav-link(href='index.html#portfolio') Portfolio
                        li.nav-item
                            a.nav-link(href='index.html#contact') Contact

        // Header
        header.masthead.small-masthead.bg-primary.text-white
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center.text-center
                    .col-lg-8
                        h1.font-weight-bold Meet Our Team
                        hr.divider.divider-light
                        p.text-white-75.mb-0
                            | Dedicated professionals committed to engineering secure and scalable digital futures.

        // Team Section
        section.page-section.bg-dark.text-white(style='background: linear-gradient(135deg, #001a33 0%, #002d5b 100%);')
            .container.px-4.px-lg-5
                .text-center.mb-5
                    h2.text-white Leadership & Engineering
                    hr.divider.divider-light
                    p.lead.text-white-75 Driven by excellence, security, and innovation.

                .row.gx-4.gx-lg-5.justify-content-center
                    // Team Member 1
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-shield-lock
                            h4.h5.mb-1 Team Member 1
                            p.text-primary.small.fw-bold.mb-3 Lead Architect
                            p.text-muted.small
                                | Specialized in building high-security distributed systems and driving OXBIY's technical vision.
                            .d-flex.justify-content-center.gap-3.mt-3
                                a.text-muted(href='#')
                                    i.bi-linkedin
                                a.text-muted(href='#')
                                    i.bi-envelope

                    // Team Member 2
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-code-slash
                            h4.h5.mb-1 Team Member 2
                            p.text-primary.small.fw-bold.mb-3 Senior Engineer
                            p.text-muted.small
                                | Focused on scalable backend infrastructure, automation, and maintaining system integrity.
                            .d-flex.justify-content-center.gap-3.mt-3
                                a.text-muted(href='#')
                                    i.bi-linkedin
                                a.text-muted(href='#')
                                    i.bi-envelope

                    // Team Member 3
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-palette
                            h4.h5.mb-1 Team Member 3
                            p.text-primary.small.fw-bold.mb-3 UI/UX Designer
                            p.text-muted.small
                                | Crafting intuitive and secure user experiences that bridge the gap between complexity and usability.
                            .d-flex.justify-content-center.gap-3.mt-3
                                a.text-muted(href='#')
                                    i.bi-linkedin
                                a.text-muted(href='#')
                                    i.bi-envelope

                    // Team Member 4
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-graph-up-arrow
                            h4.h5.mb-1 Team Member 4
                            p.text-primary.small.fw-bold.mb-3 Growth Lead
                            p.text-muted.small
                                | Strategic growth expert focused on bridging the gap between technology and business value for our clients.
                            .d-flex.justify-content-center.gap-3.mt-3
                                a.text-muted(href='#')
                                    i.bi-linkedin
                                a.text-muted(href='#')
                                    i.bi-envelope

                    // Team Member 5
                    .col-lg-4.col-md-6.mb-5
                        .team-bubble.text-center
                            .member-icon-wrap
                                i.bi-cpu
                            h4.h5.mb-1 Team Member 5
                            p.text-primary.small.fw-bold.mb-3 Tech Strategist
                            p.text-muted.small
                                | Driving innovation through cutting-edge technology adoption and security-first engineering practices.
                            .d-flex.justify-content-center.gap-3.mt-3
                                a.text-muted(href='#')
                                    i.bi-linkedin
                                a.text-muted(href='#')
                                    i.bi-envelope

        // Footer
        footer.bg-dark.text-white.py-5
            .container.px-4.px-lg-5
                .row.align-items-center
                    .col-lg-4.text-center.text-lg-start.mb-4.mb-lg-0
                        img.footer-logo.mb-3(src='/assets/img/logo.png', alt='OXBIY')
                        div OXBIY © 2026. All rights reserved.
                    .col-lg-4.text-center.mb-4.mb-lg-0
                        ul.list-inline.mb-0
                            li.list-inline-item.me-4
                                a.text-white-50(href='index.html') Home
                            li.list-inline-item.me-4
                                a.text-white-50(href='about-us.html') About
                            li.list-inline-item
                                a.text-white-50(href='index.html#contact') Contact
                    .col-lg-4.text-center.text-lg-end
                        .d-flex.justify-content-center.justify-content-lg-end.gap-3
                            a.text-white-50(href='#', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on LinkedIn')
                                i.bi-linkedin.fs-4
                            a.text-white-50(href='https://www.facebook.com/share/18j4TQiY39/', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Facebook')
                                i.bi-facebook.fs-4
                            a.text-white-50(href='https://www.instagram.com/oxbiy?utm_source=qr&igsh=MWZudGhpbmVsY201eQ==', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Instagram')
                                i.bi-instagram.fs-4

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/scripts.js')
