doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Job Finder — A secure, scalable recruitment platform by OXBIY connecting job seekers with employers through real-time matching.')
        meta(name='author', content='OXBIY')

        title Job Finder Case Study — OXBIY

        // Canonical URL
        link(rel='canonical', href='https://oxbiy.com/project-jobbe.html')

        // Open Graph
        meta(property='og:type', content='article')
        meta(property='og:site_name', content='OXBIY')
        meta(property='og:title', content='Job Finder Case Study — OXBIY')
        meta(property='og:description', content='A secure, scalable recruitment platform connecting job seekers with employers through real-time matching and end-to-end encrypted data.')
        meta(property='og:url', content='https://oxbiy.com/project-jobbe.html')
        meta(property='og:image', content='https://oxbiy.com/assets/img/bg-masthead.jpg')
        meta(property='og:image:alt', content='Job Finder Recruitment Platform — OXBIY')

        // Twitter Card
        meta(name='twitter:card', content='summary_large_image')
        meta(name='twitter:title', content='Job Finder Case Study — OXBIY')
        meta(name='twitter:description', content='A secure, scalable recruitment platform by OXBIY.')
        meta(name='twitter:image', content='https://oxbiy.com/assets/img/bg-masthead.jpg')

        // Favicon
        link(rel='icon', type='image/png', href='assets/img/oxbiy_logo_transparent.png')
        link(rel='apple-touch-icon', href='assets/img/oxbiy_logo_transparent.png')

        // Bootstrap Icons
        link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css', rel='stylesheet')

        // Google fonts
        link(rel='preconnect', href='https://fonts.googleapis.com')
        link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin='')
        link(href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

        // Analytics
        script(defer, data-domain='oxbiy.com', src='https://plausible.io/js/plausible.js')

    body#page-top

        a.skip-to-main(href='#project-content') Skip to main content

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-light.fixed-top.py-3.navbar-shrink
            .container.px-4.px-lg-5
                a.navbar-brand.d-flex.align-items-center.gap-2(href='index.html')
                    img.logo(src='/assets/img/logo.png', alt='OXBIY')
                    span.brand-name OXBIY
                button.navbar-toggler.navbar-toggler-right(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    span.navbar-toggler-icon
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.my-2.my-lg-0
                        li.nav-item
                            a.nav-link(href='index.html') Home
                        li.nav-item
                            a.nav-link(href='about-us.html') About

        // Header
        header.masthead.small-masthead.bg-primary.text-white
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5.justify-content-center.text-center
                    .col-lg-8
                        h1.font-weight-bold Job Finder
                        hr.divider.divider-light
                        p.text-white-75.mb-0
                            | Redefining recruitment through secure, data-driven connections.

        // Project Content
        section#project-content.page-section
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5
                    .col-lg-8
                        h2.mb-4 The Challenge
                        p.text-muted.mb-4
                            | Recruitment platforms often suffer from security vulnerabilities and poor user experience, leading to data breaches and inefficient hiring processes. Our goal was to build a platform that prioritizes user privacy while delivering a seamless, real-time matching experience.
                        
                        h2.mb-4 Our Solution
                        p.text-muted.mb-4
                            | Job Finder is a high-performance recruitment engine built with a security-first architecture. It features end-to-end encryption for candidate data, real-time job alerts, and an intuitive dashboard for both employers and job seekers.
                        
                        .row.mb-4
                            .col-md-6.mb-3
                                .p-3.bg-light.rounded-3
                                    h5.h6.fw-bold Secure Authentication
                                    p.small.text-muted.mb-0 Multi-factor authentication and role-based access control.
                            .col-md-6.mb-3
                                .p-3.bg-light.rounded-3
                                    h5.h6.fw-bold Real-time Engine
                                    p.small.text-muted.mb-0 Instant notifications and live application tracking.

                    .col-lg-4
                        .card.border-0.shadow-sm.rounded-3.p-4.mb-4
                            h5.h6.fw-bold.mb-3 Project Info
                            ul.list-unstyled.small.mb-0
                                li.mb-2.d-flex.justify-content-between
                                    span.text-muted Client:
                                    span.fw-bold Confidential
                                li.mb-2.d-flex.justify-content-between
                                    span.text-muted Category:
                                    span.fw-bold Recruitment
                                li.mb-2.d-flex.justify-content-between
                                    span.text-muted Date:
                                    span.fw-bold May 2026
                                li.d-flex.justify-content-between
                                    span.text-muted Tech:
                                    span.fw-bold React, Node.js

                .row.gx-4.gx-lg-5.mt-5
                    .col-12
                        img.img-fluid.rounded-3.shadow-lg(src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80', alt='Job Finder Digital Platform Interface', loading='lazy')

        // Footer
        footer.bg-light.py-5
            .container.px-4.px-lg-5.text-center
                img.footer-logo.mb-3(src='/assets/img/logo.png', alt='OXBIY')
                .footer-social.d-flex.justify-content-center.gap-3.mb-4
                    a.text-muted(href='https://www.linkedin.com/in/oxbiy-company-74b356410?utm_source=share_via&utm_content=profile&utm_medium=member_android', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on LinkedIn')
                        i.bi-linkedin
                    a.text-muted(href='https://www.facebook.com/share/18j4TQiY39/', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Facebook')
                        i.bi-facebook
                    a.text-muted(href='https://www.instagram.com/oxbiy?utm_source=qr&igsh=MWZudGhpbmVsY201eQ==', target='_blank', rel='noreferrer', aria-label='Follow OXBIY on Instagram')
                        i.bi-instagram
                a.btn.btn-primary.btn-xl.mb-4(href='index.html#portfolio') Back to Projects
                div OXBIY © 2026

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/scripts.js')
